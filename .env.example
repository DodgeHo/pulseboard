NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
API_SHUTDOWN_TIMEOUT_MS=10000
WORKER_SHUTDOWN_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=2000
METRICS_SCRAPE_TIMEOUT_MS=2000

# From Windows: F:\Jobs overseas\pulseboard
# From WSL: /mnt/f/Jobs\ overseas/pulseboard
DATABASE_URL=postgresql://pulseboard:pulseboard@localhost:5432/pulseboard?schema=public
REDIS_URL=redis://localhost:6379
OPERATIONAL_METRICS_REDIS_PREFIX=pulseboard:operational-metrics:v1
POSTGRES_PASSWORD=pulseboard

# Optional image overrides for networks where Docker Hub is slow or blocked.
# Keep defaults in compose for normal environments; uncomment these locally if needed.
# Production deployments should set PULSEBOARD_IMAGE to a registry tag or digest
# that identifies one reviewed build, PULSEBOARD_BUILD_REVISION to its commit SHA,
# and PULSEBOARD_BUILD_CONTRACT to the reviewed compatibility contract.
# PULSEBOARD_IMAGE=registry.example.com/pulseboard:git-<commit-sha>
# PULSEBOARD_BUILD_REVISION=<commit-sha>
# PULSEBOARD_BUILD_CONTRACT=current
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
# REDIS_IMAGE=public.ecr.aws/docker/library/redis:7-alpine
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim
# NPM_REGISTRY=https://registry.npmmirror.com
# APT_DEBIAN_MIRROR=http://mirrors.cloud.tencent.com/debian
# APT_SECURITY_MIRROR=http://mirrors.cloud.tencent.com/debian-security

# Local demo API key. Do not reuse this value outside local development.
DEMO_API_KEY=pb_local_demo_key_change_me
# Local-only fallback. Production startup and seed reject this value and require
# an independently generated API_KEY_HASH_SALT of at least 32 characters.
API_KEY_HASH_SALT=local-development-only

CHECK_SCHEDULER_INTERVAL_MS=60000
HTTP_CHECK_TIMEOUT_MS=5000
CHECK_EXECUTION_LEASE_MS=60000
UPTIME_JOB_LOCK_DURATION_MS=30000
UPTIME_JOB_STALLED_INTERVAL_MS=30000
WRITE_RATE_LIMIT_WINDOW_MS=60000
WRITE_RATE_LIMIT_MAX=120
